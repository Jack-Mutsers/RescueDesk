<Window x:Class="RescueDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RescueDesk" Width="1400" Height="860" MinWidth="1080" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextBrush}" Icon="Assets/RescueDesk.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: source, scan modes, progress -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,18,20,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/RescueDesk.ico" Width="28" Height="28" Margin="0,0,10,0"/>
                        <TextBlock Text="RescueDesk" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Find deleted files and rescue files from damaged or formatted drives. The drive you scan is only read, never changed."/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="DRIVE TO SCAN"/>
                    <DockPanel>
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="Refresh drive list" Margin="6,0,0,0" Click="Refresh_Click"/>
                        <ComboBox x:Name="SourceBox" Height="48" SelectionChanged="SourceBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <Button Style="{StaticResource SoftButton}" Margin="0,6,0,0" HorizontalAlignment="Left" Click="OpenImage_Click"
                            Content="Open a disk image file…"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="SCAN"/>
                    <Button x:Name="QuickScanButton" Style="{StaticResource ModeButton}" Click="QuickScan_Click">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="14"><Run FontFamily="{StaticResource IconFont}" Text="&#xE74D;"/>  Find deleted files</TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="Fast. Reads the NTFS file table and finds deleted files with their original names and folders."/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="IncludeExistingBox" Margin="4,0,0,10"
                              Content="Also list files that still exist"
                              ToolTip="Use this to copy files off a drive that Windows can no longer open."/>

                    <Button x:Name="DeepScanButton" Style="{StaticResource ModeButton}" Click="DeepScan_Click">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="14"><Run FontFamily="{StaticResource IconFont}" Text="&#xE721;"/>  Deep scan</TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="Slow. Searches every sector for photos, documents, videos and archives. Works on formatted, RAW or corrupted drives, but names and folders are lost."/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="FreeSpaceOnlyBox" Margin="4,0,0,0" IsChecked="True"
                              Content="Skip space used by existing files"
                              ToolTip="Faster, and avoids finding files you still have. Turn off if the file system is damaged."/>
                    <Expander Header="File types" Margin="0,4,0,0">
                        <ItemsControl x:Name="TypeList" Margin="4,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Description}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="ProgressBar" Height="6" Maximum="1" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Background="{DynamicResource TrackBrush}"/>
                    <Button x:Name="CancelButton" Style="{StaticResource SoftButton}" Content="Cancel" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Click="Cancel_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource WarningBackBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}">
                    <Run FontFamily="{StaticResource IconFont}" Text="&#xE7BA;"/>
                    <Run FontWeight="SemiBold" Text=" Stop using the drive you want to recover from."/>
                    <Run Text="Every file written to it can overwrite deleted data. Always save recovered files to a different drive."/>
                </TextBlock>
            </Border>

            <DockPanel Grid.Row="1" Margin="20,14,20,10" LastChildFill="False">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="240" TextChanged="Filter_Changed"
                         ToolTip="Filter by name or folder"/>
                <ComboBox x:Name="TypeFilter" DockPanel.Dock="Left" Width="130" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
                <CheckBox x:Name="HideOverwrittenBox" DockPanel.Dock="Left" Margin="12,0,0,0" IsChecked="True"
                          Content="Hide likely overwritten" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Select none" Margin="6,0,0,0" Click="SelectNone_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Select all shown" Click="SelectAll_Click"/>
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="SearchPlaceholder" Text="Search name or folder" Margin="28,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource PlaceholderBrush}" IsHitTestVisible="False" HorizontalAlignment="Left"/>

            <Grid Grid.Row="2" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" RowHeight="28" SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True" SelectionChanged="ResultsGrid_SelectionChanged" PreviewKeyDown="ResultsGrid_PreviewKeyDown">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              Click="RowCheck_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" MinWidth="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Folder" Binding="{Binding FolderText}" Width="2*" MinWidth="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=g}" Width="125" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Condition" SortMemberPath="Condition" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,6,0" Fill="#9CA3AF"/>
                                        <TextBlock Text="{Binding ConditionText}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Condition}" Value="Good">
                                            <Setter TargetName="Dot" Property="Fill" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Condition}" Value="Partial">
                                            <Setter TargetName="Dot" Property="Fill" Value="#F59E0B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Condition}" Value="Overwritten">
                                            <Setter TargetName="Dot" Property="Fill" Value="#DC2626"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding KindText}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False"
                           Text="Choose a drive and start a scan. Found files appear here."/>

                <!-- Preview -->
                <Border Grid.Column="1" Margin="14,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource PanelBrush}">
                    <DockPanel Margin="14">
                        <StackPanel DockPanel.Dock="Bottom" x:Name="DetailsPanel">
                            <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailInfo" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <ScrollViewer x:Name="PreviewTextScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </ScrollViewer>
                            <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" Text="Select a file to preview it."/>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="20,12">
                <DockPanel>
                    <Button x:Name="RecoverButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" IsEnabled="False" Click="Recover_Click">
                        <TextBlock><Run FontFamily="{StaticResource IconFont}" Text="&#xE896;"/>  Recover selected files…</TextBlock>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectionText" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
